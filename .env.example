# =============================================================
# 个人工作台环境变量示例
# 复制为 .env 后填写：cp .env.example .env
# 切勿把真实密钥提交到 Git（.env 已在 .gitignore 中）
# =============================================================

# ---- 必填密钥 ----
# SECRET_KEY 用于 JWT 签名，务必随机生成：
#   openssl rand -base64 48
# 未设置时应用会生成临时密钥，重启后所有登录态失效
SECRET_KEY=change-me-generate-with-openssl-rand-base64-48

# ---- MySQL / Compose ----
# MySQL root 密码（仅容器初始化 / 运维使用）
MYSQL_ROOT_PASSWORD=change-me-root-password
# 应用连接 MySQL 使用的密码（与 DB_PASSWORD 保持一致）
MYSQL_PASSWORD=change-me-db-password

# ---- 数据库（后端读取）----
DB_HOST=workspace-mysql
DB_PORT=3306
DB_USER=workspace
DB_PASSWORD=change-me-db-password
DB_NAME=personal_workspace

# ---- Redis（后端读取，登录限流）----
REDIS_HOST=workspace-redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# ---- JWT / 会话 ----
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- 登录限流 ----
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=300

# ---- 初始管理员（仅 users 表为空时创建）----
# 首次启动后请立即登录并修改密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_EMAIL=admin@example.com

# ---- CORS（逗号分隔）----
CORS_ORIGINS=http://localhost:3001

# ---- 调试 ----
DEBUG=false
